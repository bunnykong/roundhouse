# Typing for runtime/spinel/active_job_serialization.rb. Readers take
# the parsed `arguments` array, which is `JSON.parse` output and so
# `untyped`, the same contract as `RoundhouseJsonColumn.load`.
module ActiveJob
  def self.adapter_name: (untyped adapter) -> String
  module Arguments
    GLOBALID_KEY: String
    SERIALIZER_KEY: String
    SYMBOL_SERIALIZER: String
    TIME_SERIALIZER: String

    def self.null: () -> String
    def self.bool: (bool value) -> String
    def self.int: (Integer value) -> String
    def self.float: (Float value) -> String
    def self.str: (String value) -> String
    def self.sym: (Symbol value) -> String
    def self.record: (String gid_uri) -> String
    def self.time: (Time value) -> String
    def self.list: (Array[String] parts) -> String
    def self.turbo_broadcast_options: (String action, String target, String partial, String local, String gid_uri) -> String

    def self.arg_count: (untyped args) -> Integer
    def self.null_at: (untyped args, Integer i) -> bool
    def self.bool_at: (untyped args, Integer i) -> bool
    def self.int_at: (untyped args, Integer i) -> Integer
    def self.float_at: (untyped args, Integer i) -> Float
    def self.str_at: (untyped args, Integer i) -> String
    def self.sym_at: (untyped args, Integer i) -> Symbol
    def self.time_at: (untyped args, Integer i) -> Time
    def self.int_array_at: (untyped args, Integer i) -> Array[Integer]
    def self.float_array_at: (untyped args, Integer i) -> Array[Float]
    def self.str_array_at: (untyped args, Integer i) -> Array[String]
    def self.bool_array_at: (untyped args, Integer i) -> Array[bool]
    def self.sym_array_at: (untyped args, Integer i) -> Array[Symbol]
    def self.option_str_at: (untyped args, Integer i, String key) -> String
    def self.option_sym_name_at: (untyped args, Integer i, String key) -> String
    def self.option_local_at: (untyped args, Integer i, String name) -> untyped
    def self.gid_parts: (untyped value) -> Array[String]
    def self.missing_record_message: (String model_name, String id) -> String
    def self.deserialize_message: (String detail) -> String
    def self.serialized_value: (untyped value, String serializer) -> String
    def self.key_of: (untyped value, String key) -> untyped
    def self.parse_time: (String text) -> Time
    TIME_WITH_ZONE_SERIALIZER: String
    SYMBOL_KEYS_KEY: String
    RUBY2_KEYWORDS_KEY: String
    WITH_INDIFFERENT_ACCESS_KEY: String
    def self.serialize: (untyped arguments) -> Array[untyped]
    def self.serialize_argument: (untyped argument) -> untyped
    def self.serialize_hash_key: (untyped key) -> String
    def self.keywords: (Array[String] names, Array[String] parts) -> String
    def self.keyword_given?: (untyped args, String name) -> bool
    def self.keyword_args: (untyped args, String name) -> Array[untyped]
    def self.ruby2_keywords_hash: (untyped hash) -> untyped
    def self.ruby2_keywords_hash?: (untyped hash) -> bool
    def self.deserialize: (untyped arguments) -> Array[untyped]
    def self.deserialize_argument: (untyped argument) -> untyped
    def self.deserialize_serialized: (untyped hash) -> untyped
    def self.deserialize_hash: (untyped hash) -> Hash[untyped, untyped]
  end

  module Payload
    def self.build: (String job_class, String queue_name, String arguments_json) -> String
    def self.build_at: (String job_class, String queue_name, Float at, String arguments_json) -> String
  end
end

module ActiveJob
  class Base
    attr_accessor job_id: String?
    attr_accessor queue_name: String?
    attr_accessor priority: Integer?
    attr_accessor scheduled_at: Time?
    attr_accessor enqueued_at: Time?
    attr_accessor executions: Integer?
    attr_accessor arguments_json: String?
    attr_accessor provider_job_id: untyped
    attr_accessor successfully_enqueued: bool?
    attr_accessor enqueue_error: ActiveJob::EnqueueError?
    def successfully_enqueued?: () -> bool
    def set: (?Hash[Symbol, untyped] options) -> self
    def concurrency_key: () -> nil
    def serialize: () -> Hash[String, untyped]
    def deserialize: (Hash[String, untyped] job_data) -> ActiveJob::Base
    def serialize_extras: () -> String
    def deserialize_extras: (Hash[String, untyped] job_data) -> nil
    def self.deserialize: (Hash[String, untyped] job_data) -> ActiveJob::Base
    def run_callbacks: (Symbol kind) { () -> untyped } -> untyped
  end

  module Payload
    def self.of: (ActiveJob::Base job) -> String
    def self.time_or_null: (Time? time) -> String
  end
end
