# Signatures for the spinel-subset temporal intrinsics. `str` is the
# raw TEXT column value the synthesized reader passes — nil/"" for
# absent storage (the nil-guard narrows before the positional parse).
module ActiveSupport
  def self.parse_db_time: (String? str) -> Time?
  def self.json_time: (String? str) -> String?
  def self.db_now: () -> String
  # The test clock — see the TEST CLOCK block in the .rb.
  def self.now: () -> Time
  def self.travel: (Integer seconds) -> void
  def self.freeze: (Integer seconds) -> void
  def self.clock: () -> Time
  def self.travel_offset: () -> Integer
  def self.format_db_time: (untyped value) -> String?
  def self.parse_time: (String str) -> Time
  def self.zone_parse: (String str) -> Time?
  def self.cast_datetime: (untyped value) -> Time?
  def self.parse_fields: (String str, bool in_zone) -> Time?
  def self.build_time: (bool in_zone, Integer year, Integer mon, Integer mday, String? hour_s, String? min_s, String? sec_s, String? frac, String? zone) -> Time
end
