# Typing contract for the typed Request value object (request.rb
# beside this file). `attr_accessor` in the .rb surfaces here as
# getter+setter def pairs, per the runtime .rbs convention.
module ActionDispatch
  class RequestBody
    @text: String
    @pos: Integer
    def initialize: (String text) -> void
    def string: () -> String
    def rewind: () -> Integer
    def read: () -> String
    def size: () -> Integer
    def length: () -> Integer
    def eof?: () -> bool
  end

  # See the .rb. A Rack env's KEYS are Strings by the spec, which is
  # what lets the mapping compare them without coercing; its VALUES are
  # not (`rack.input` is an IO, `rack.errors` a stream), so they stay
  # untyped and the mapping `.to_s` each one it takes.
  module TestRequest
    def self.create: (Hash[String, untyped] env) -> Request
  end

  class Request
    @remote_ip: String
    @path: String
    @query_string: String
    @script_name: String
    @request_method: String
    @referer: String
    @host: String
    @format: String
    @body: String
    @body_io: RequestBody?
    @env: Hash[String, untyped]
    @path_parameters: RequestPathParameters
    @user_agent: String
    @session_options: Hash[Symbol, bool]
    @session: Session?
    @flash: ActionDispatch::Flash?
    @params: Hash[String, Roundhouse::ParamValue]
    @csp_ready: bool
    @content_security_policy: ContentSecurityPolicy?

    def remote_ip: () -> String
    def remote_ip=: (String) -> String
    def path: () -> String
    def path=: (String) -> String
    def query_string: () -> String
    def query_string=: (String) -> String
    def script_name: () -> String
    def script_name=: (String) -> String
    def request_method: () -> String
    def request_method=: (String) -> String
    def referer: () -> String
    def referer=: (String) -> String
    def host: () -> String
    def host=: (String) -> String
    def raw_host_with_port: () -> String
    def forwarded_authority: () -> String
    def trusted_forwarded_peer?: () -> bool
    def host_authority?: (String value) -> bool
    def format: () -> Mime::Type
    def domain: () -> String?
    def subdomains: () -> Array[String]
    def subdomain: () -> String
    def named_host_parts: () -> Array[String]
    def format=: (untyped value) -> untyped
    def body: () -> RequestBody
    def body=: (String) -> String
    def raw_post: () -> String
    def env: () -> Hash[String, untyped]
    def flash: () -> ActionDispatch::Flash?
    def flash=: (ActionDispatch::Flash?) -> ActionDispatch::Flash?
    def env=: (Hash[String, untyped]) -> Hash[String, untyped]
    def headers: () -> ActionDispatch::Http::Headers
    def request_id: () -> String?
    def request_id=: (String value) -> String
    def uuid: () -> String?
    def path_parameters: () -> RequestPathParameters
    def path_parameters=: (Hash[String, String]) -> RequestPathParameters
    def authorization: () -> String?
    def request_parameters: () -> Hash[String, Roundhouse::ParamValue]
    def request_parameters=: (Hash[String, Roundhouse::ParamValue]) -> Hash[String, Roundhouse::ParamValue]
    def query_parameters: () -> Hash[String, Roundhouse::ParamValue]
    def query_parameters=: (Hash[String, Roundhouse::ParamValue]) -> Hash[String, Roundhouse::ParamValue]
    def initialize: () -> void
    def self.for_env: (Hash[String, untyped] env) -> ActionDispatch::Request
    def request_method_symbol: () -> Symbol
    def get?: () -> bool
    def post?: () -> bool
    def put?: () -> bool
    def patch?: () -> bool
    def head?: () -> bool
    def xhr?: () -> bool
    def inertia?: () -> bool
    def fullpath: () -> String
    def original_fullpath: () -> String
    def ssl?: () -> bool
    def protocol: () -> String
    def optional_port: () -> Integer?
    def port: () -> Integer
    def base_url: () -> String
    def host_with_port: () -> String
    def content_security_policy: () -> ContentSecurityPolicy?
    def original_url: () -> String
    def url: () -> String
    def referrer: () -> String
    def user_agent: () -> String
    def session_options: () -> Hash[Symbol, bool]
    def session: () -> Session
    def session=: (Session) -> Session
    def reset_session: () -> ActionDispatch::Session
    def session_skip?: () -> bool
    def user_agent=: (String) -> String
    def params: () -> Hash[String, Roundhouse::ParamValue]
    def filtered_parameters: () -> Hash[String, untyped]
    def params=: (Hash[String, Roundhouse::ParamValue]) -> Hash[String, Roundhouse::ParamValue]
    def self.for: (Hash[String, untyped] env, ?Hash[String, untyped] params) -> Request
  end
end
