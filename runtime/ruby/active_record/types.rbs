module ActiveRecord
  module Type
    class Value
      @type: Symbol?
      @json_coder: bool
      def type: () -> Symbol?
      def initialize: (Symbol? type, ?bool json_coder) -> void
      def serialize: (untyped value) -> untyped
    end

    class String
      def cast: (untyped value) -> String?
      def deserialize: (untyped value) -> String?
    end

    class Integer
      def cast: (untyped value) -> Integer?
      def deserialize: (untyped value) -> Integer?
    end
  end
end
